{
  "name": "ucm-watchlist",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun --hot src/index.html",
    "build": "bun run build.ts",
    "preview": "bun run preview.ts",
    "test": "bun test",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun --bun oxlint",
    "typecheck": "bun check",
    "verify": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.4.5",
    "bun-plugin-tailwind": "^0.1.2",
    "lefthook": "^2.2.2",
    "oxlint": "^1.94.0",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.0.0"
  }
}
